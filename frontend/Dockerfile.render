# Imagen del gateway para Render (HTTP plano en :10000 + Basic Auth).
# Contexto de build: raíz del repositorio (igual que frontend/Dockerfile).

# Etapa 1: Construcción del Frontend 3D (Vite + Three.js)
FROM node:22-alpine AS frontend-builder

WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# Etapa 2: Nginx sin TLS propio (Render termina TLS)
FROM nginx:1.27-alpine

RUN apk upgrade --no-cache && \
    apk add --no-cache openssl && \
    rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf && \
    mkdir -p /var/cache/nginx /var/run/nginx

COPY --from=frontend-builder /build/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.render.conf /etc/nginx/nginx.conf
COPY deploy/nginx/entrypoint-render.sh /docker-entrypoint.d/05-basic-auth.sh
RUN chmod +x /docker-entrypoint.d/05-basic-auth.sh

RUN chown -R nginx:nginx /var/cache/nginx /var/run/nginx /var/log/nginx

USER nginx

EXPOSE 10000
