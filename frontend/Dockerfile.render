# Imagen única para Render (plan gratuito): Nginx + FastAPI en el mismo contenedor.
# Contexto de build: raíz del repositorio.
# Raspberry y VPS siguen usando frontend/Dockerfile y backend/Dockerfile por separado.

# Etapa 1: Construcción del Frontend 3D (Vite + Three.js)
FROM node:22-alpine AS frontend-builder

WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# Etapa 2: Python (FastAPI) + Nginx
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx openssl && \
    apt-get upgrade -y && \
    rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /usr/sbin/nologin -m appuser

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --upgrade pip "setuptools>=78.1.1" && \
    pip install -r requirements.txt && \
    pip uninstall -y pip setuptools wheel

COPY backend/alembic.ini backend/pyproject.toml ./
COPY backend/alembic ./alembic
COPY backend/app ./app
COPY backend/tests ./tests

COPY --from=frontend-builder /build/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.render.conf /app/nginx.render.conf
COPY deploy/nginx/entrypoint-render.sh /app/entrypoint-render.sh
COPY deploy/render/start.sh /app/start.sh
RUN chmod +x /app/entrypoint-render.sh /app/start.sh && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 10000

CMD ["/app/start.sh"]
